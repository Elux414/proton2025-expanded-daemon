#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/ucode /usr/share/proton2025/daemon.uc
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/config/proton2025
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "proton2025"
}
